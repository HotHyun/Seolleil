# Copy to /etc/appwrite-backup/restic.env, replace placeholders, then chmod 0600.
# Never commit real Backblaze credentials or the Restic password.

AWS_ACCESS_KEY_ID='BACKBLAZE_KEY_ID'
AWS_SECRET_ACCESS_KEY='BACKBLAZE_APPLICATION_KEY'
RESTIC_REPOSITORY='s3:https://s3.us-west-004.backblazeb2.com/hothyun-appwrite-backup-a7k2m9'
RESTIC_PASSWORD_FILE='/etc/appwrite-backup/restic-password'
