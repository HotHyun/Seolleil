[Unit]
Description=Back up Appwrite MariaDB to Backblaze B2 with Restic
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /usr/local/sbin/appwrite-db-backup
User=root
Group=root
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
