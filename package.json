{
  "name": "korean-ski",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:remote": "playwright test",
    "test:e2e:production": "E2E_BASE_URL=https://ski.hothyun.com E2E_ALLOW_PRODUCTION_WRITES=1 playwright test tests/e2e/production-regression.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm typecheck && pnpm test && pnpm test:e2e",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "pnpm cf:build && tsx scripts/with-env.ts wrangler dev",
    "cf:deploy": "tsx scripts/with-env.ts opennextjs-cloudflare build && tsx scripts/with-env.ts opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv src/types/cloudflare-env.d.ts",
    "data:validate": "tsx scripts/validate-static-data.ts",
    "data:report": "tsx scripts/report-static-data.ts",
    "data:links": "tsx scripts/check-links.ts",
    "data:locations:audit": "tsx scripts/audit-rental-locations.ts --write",
    "data:locations": "tsx scripts/generate-rental-location-data.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@sentry/nextjs": "10.42.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.54.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.153.0"
  },
  "packageManager": "pnpm@9.15.0"
}
